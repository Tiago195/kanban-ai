// Prisma schema — Kanban-AI
// Fonte da verdade do domínio: docs/reference/kanban.html
// NOTA v1: DOR e `acceptance` foram REMOVIDOS. O único checklist é o DOD.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum CardType {
  epic
  story
  task
}

enum ExecState {
  idle
  analyzing
  implementing
  validating
  blocked_dep // "blocked-dep" no domínio
  done
}

// EP-BLOCK / US-BLOCK1 (ADR-0039) — taxonomia typed de bloqueio.
enum BlockKind {
  dependency
  needs_input
  capability
  transient
}

enum IterationPhase {
  reproduce
  analysis
  implementation
  validation
}

enum ValidationStrategy {
  flows_regression // flows+regression
  bug_gone_regression // bug-gone+regression
  regression_only // regression-only
}

// EP-COLAB / US-COLAB3 — estados de um item da wakeup queue durável.
enum WakeupStatus {
  pending // aguardando o processador in-process
  claimed // sendo processado por uma sessão in-process
  done    // processado com sucesso
  failed  // falhou (mantido para auditoria/retry)
}

// EP-COLAB / US-COLAB3 — motivo pelo qual a story precisa acordar.
enum WakeupReason {
  story_in_progress // story entrou/está em In Progress (gatilho clássico)
  task_added        // task nova adicionada a story em progresso (BUG-09)
  hitl_answered     // humano respondeu uma pergunta pendente
  manual_step       // "Rodar 1 iteração" / stepOnce
  reconcile         // re-enfileirado no boot a partir do board
  blockers_resolved // EP-BLOCK/US-BLOCK3: dependência(s) fecharam → auto-wake
  issue_unblock     // EP-BLOCK/US-BLOCK2: bloqueio de input resolvido pelo owner
  continuation      // EP-CTX/US-CTX3: continuação bounded de run improdutivo
}

// ─────────────────────────────────────────────────────────────
// Project (repo git clonado & gerenciado) — EP-PROJECT / US-PROJ1
// ─────────────────────────────────────────────────────────────

// Tipo de autenticação do repositório git do Project. Ver US-PROJ3.
enum ProjectAuthKind {
  none  // repo público (https)
  https // https + token (PAT)
  ssh   // ssh key
}

// Estado do clone gerenciado do Project. Ver US-PROJ2.
enum ProjectCloneState {
  pending // criado, ainda não clonado
  cloning // clone em andamento
  ready   // clone disponível em localPath
  failed  // clone/sync falhou (ver lastError)
}

// Entidade de primeira classe que representa "o repositório em que a frota
// trabalha", desacoplada de path físico. Ortogonal à hierarquia Epic→Story→Task
// (associada ao Board, raiz da cascata de repo-alvo). Ver docs/specs/ep-project.md.
model Project {
  id            String            @id @default(uuid())
  name          String
  repoUrl       String // https://... ou git@...:...
  defaultBranch String? // null = branch default do remoto (HEAD)
  authKind      ProjectAuthKind   @default(none)
  // Referência OPACA à credencial (nunca o segredo em si). Ver US-PROJ3.
  credentialRef String?
  // Path gerenciado do clone (PROJECTS_DIR/<id>). Preenchido pelo clone.
  localPath     String?
  cloneState    ProjectCloneState @default(pending)
  lastError     String?
  lastSyncedAt  DateTime?
  // Multi-tenant cooperativo (mesmo rótulo opaco de Card.tenantId, ADR-0009).
  tenantId      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  boards Board[]
}

// ─────────────────────────────────────────────────────────────
// Board & colunas
// ─────────────────────────────────────────────────────────────

model Board {
  id           String   @id @default(uuid())
  title        String
  seq          Int      @default(0) // contador para chaves EP-/US-/TK-
  defaultModel String? // modelo default do quadro (raiz da cascata de heranca)
  // EP-PROJECT / US-PROJ1 — repo-alvo do quadro (raiz da cascata, análoga a
  // defaultModel). Nullable: Board sem projectId cai no fallback Card.aiProject.
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  columns             Column[]
  cards               Card[]
  labels              Label[]
  assignees           Assignee[]
  loopProfiles        LoopProfile[]
  backlogChatSessions BacklogChatSession[]
}

// Colunas do board principal (stories) e do mini-kanban (tasks).
// `isTaskColumn` distingue os dois fluxos.
model Column {
  id           String  @id @default(uuid())
  boardId      String
  board        Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title        String
  wipLimit     Int?
  protected    Boolean @default(false)
  isTaskColumn Boolean @default(false)
  position     Int     @default(0)

  // Cards posicionados nesta coluna (stories/epics via boardColumn; tasks via taskColumn)
  boardCards Card[] @relation("BoardColumn")
  taskCards  Card[] @relation("TaskColumn")

  @@index([boardId])
}

// ─────────────────────────────────────────────────────────────
// Card polimórfico (epic | story | task)
// ─────────────────────────────────────────────────────────────

model Card {
  id          String   @id @default(uuid())
  boardId     String
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  key         String // EP-1, US-2, TK-3
  type        CardType

  // EP-COLAB / US-COLAB1 — isolamento multi-tenant por coluna nullable.
  // null = card global (comportamento pré-COLAB, retrocompatível). Quando
  // preenchido, o card só aparece no board quando a query filtra pelo MESMO
  // tenantId (ou não filtra por tenant). Não há FK — tenant é um rótulo opaco
  // no v1 (sem auth, ADR-0009). O isolamento é cooperativo, não de segurança.
  tenantId String?
  title       String
  description String   @default("")

  points         Int? // 1,2,3,5,8,13 (só epic/story)
  priority       Int?
  idempotencyKey String?
  startInPlanMode Boolean @default(false)
  blocked        Boolean @default(false)
  everInProgress Boolean @default(false)

  // "Needs human": o loop engine desistiu da task após esgotar as tentativas
  // de validação (AGENT_MAX_VALIDATION_FAILURES). Flag/badge, não coluna nova.
  needsHuman       Boolean @default(false)
  needsHumanReason String?

  // EP-BLOCK / US-BLOCK1 (ADR-0039) — taxonomia typed do bloqueio corrente.
  // null = bloqueio genérico (comportamento pré-BLOCK, retrocompatível).
  blockKind BlockKind?

  // EP-BLOCK / US-BLOCK2 (ADR-0039) — descriptor typed do bloqueio ({ owner, action }).
  // null = prose-only (sem descriptor) => needs_attention humano.
  blockedDescriptor Json?

  // Anti re-fire do wake de unblock (US-BLOCK2). Setado ao notificar o owner=agent;
  // limpo quando o card sai de blocked (unblock/resume/done).
  blockedOwnerNotifiedAt DateTime?

  // EP-CTX / US-CTX2 (ADR-0040) — snapshot estruturado de handoff gravado ao
  // fechar a task (`done`). JSON conforme CompletionMetadata em @kanban-ai/shared.
  // null = task ainda não fechou / metadata não coletado.
  completionMetadata Json?

  // Modelo de AI para desenvolver este card. null = herda do pai
  // (task -> story -> epic -> board.defaultModel).
  model String?

  // Hierarquia: task -> story -> epic
  parentId String?
  parent   Card?   @relation("Hierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Card[]  @relation("Hierarchy")

  // Posição no board principal (para epic/story)
  boardColumnId String?
  boardColumn   Column? @relation("BoardColumn", fields: [boardColumnId], references: [id], onDelete: SetNull)

  // Posição no mini-kanban de tasks (para task)
  taskColumnId String?
  taskColumn   Column? @relation("TaskColumn", fields: [taskColumnId], references: [id], onDelete: SetNull)

  position Int @default(0)

  // ── Campos específicos de STORY ──
  aiSummary String? // aiContext.summary
  aiProject String? // aiContext.project (repo-alvo)
  aiNotes   String? // aiContext.notes

  // ── Campos específicos de TASK ──
  loopType  String? // id do loop profile (feature|bug|refactor|__default) ou custom
  execState ExecState? @default(idle)

  // Rastreio de origem: sessão do backlog-chat que materializou este card
  // (epic/story/task) no apply. `null` = card criado manualmente no board.
  // Alimenta o "chat da story" (reusa a sessão original) e o apply incremental
  // de tasks. Ver ADR-0026.
  backlogChatSessionId String?
  backlogChatSession   BacklogChatSession? @relation(fields: [backlogChatSessionId], references: [id], onDelete: SetNull)

  // Task derivada de uma falha de validação
  derivedFromId String?
  derivedFrom   Card?   @relation("Derivation", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derived       Card[]  @relation("Derivation")
  // Profundidade na cadeia de derivação (origem = 0; cada derivada = +1).
  // Alimenta o cap AGENT_MAX_DERIVED_DEPTH (anti-loop de derivações).
  derivedDepth  Int     @default(0)

  // Dependências entre tasks (grafo)
  dependsOn  TaskDependency[] @relation("Dependent")
  dependents TaskDependency[] @relation("Dependency")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações filhas
  dodItems      DodItem[]
  comments      Comment[]
  activities    Activity[]
  affectedFlows AffectedFlow[]
  iterations    Iteration[]
  agentMessages AgentMessage[]
  labels        CardLabel[]
  assignees     CardAssignee[]
  wakeups       WakeupQueue[]  @relation("WakeupStory")
  reviewComments ReviewComment[]
  reviewActions ReviewAction[]
  events        CardEvent[]

  @@unique([boardId, key])
  // idempotencyKey: índice UNIQUE PARCIAL (WHERE NOT NULL) definido direto na
  // migration SQL (Prisma não suporta índice parcial no schema). Ver
  // migrations/20260813114500_bux_card_fields.
  @@index([boardId])
  @@index([parentId])
  @@index([type])
  @@index([backlogChatSessionId])
  @@index([boardId, tenantId]) // US-COLAB1: filtro de board por tenant
}

// Aresta do grafo de dependências entre tasks.
model TaskDependency {
  id          String @id @default(uuid())
  dependentId String // a task que depende
  dependent   Card   @relation("Dependent", fields: [dependentId], references: [id], onDelete: Cascade)
  dependsOnId String // a task que precisa terminar antes
  dependsOn   Card   @relation("Dependency", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([dependentId, dependsOnId])
  @@index([dependentId])
  @@index([dependsOnId])
}

// ─────────────────────────────────────────────────────────────
// US-OBS3 (ADR-0037) — Review inline por linha
// ─────────────────────────────────────────────────────────────

// Comentário de review por LINHA, vinculado a um card (task/story) e
// opcionalmente à iteração que o originou. É observabilidade/evidência — NÃO é
// um novo checklist obrigatório (o único gate de conclusão continua sendo o
// DOD, ver ADR-0007). Aditivo e retrocompatível.
model ReviewComment {
  id          String   @id @default(cuid())
  cardId      String // task ou story alvo do comentário
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  iterationId String? // iteração que originou o comentário (opcional)
  filePath    String // caminho relativo no repo-alvo
  line        Int // linha (1-based) no arquivo pós-diff
  body        String // corpo do comentário (markdown)
  author      String // 'agent:<runnerId>' | 'human:<id>'
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([cardId])
  @@index([cardId, filePath])
}

// US-OBS2-4 — REVIEW ACTION: sinal de anomalia detectado por um scan periódico
// e surfaçado ao operador de forma VISÍVEL mas NÃO-INTRUSIVA. NÃO move/cancela a
// story — é só observabilidade (não reintroduz DOR/acceptance — ADR-0007).
// `kind` = ReviewActionKind de @kanban-ai/shared (v1: 'no_comment_streak').
// `snoozedUntil` suporta o silenciamento pelo operador; `ts` alimenta o
// rate-limit (cooldown). Aditivo e retrocompatível.
model ReviewAction {
  id           String    @id @default(cuid())
  cardId       String // story alvo do sinal
  card         Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  kind         String // ReviewActionKind de @kanban-ai/shared
  detail       Json // contexto legível (ex.: { streak, threshold, storyId })
  ts           DateTime  @default(now())
  snoozedUntil DateTime? // instante até o qual está snoozed (null = não)

  @@index([cardId, kind, ts])
}

// ─────────────────────────────────────────────────────────────
// Checklists / notas do card
// ─────────────────────────────────────────────────────────────

// Definition of Done — ÚNICO checklist do v1.
model DodItem {
  id       String  @id @default(uuid())
  cardId   String
  card     Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  text     String
  done     Boolean @default(false)
  position Int     @default(0)

  @@index([cardId])
}

model Comment {
  id       String   @id @default(uuid())
  cardId   String
  card     Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  authorId String? // assignee (agent) ou null
  text     String
  ts       DateTime @default(now())

  @@index([cardId])
}

model Activity {
  id     String   @id @default(uuid())
  cardId String
  card   Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  text   String
  ts     DateTime @default(now())

  @@index([cardId])
}

// US-OBS2-2 — LOG TIPADO E APPEND-ONLY de transições do card. Coexiste com
// `Activity` (texto livre): aqui cada linha é ESTRUTURADA (`kind` + `payload`
// JSON) e serve de fonte para replay/tail incremental (`GET /cards/:id/events
// ?since=<eventId>`) e para a tool MCP `list_card_events`. Os `kind` espelham os
// eventos WS já emitidos por `cards.service.ts`. É apenas observabilidade — não
// reintroduz DOR/acceptance (ADR-0007).
model CardEvent {
  id      String   @id @default(uuid())
  cardId  String
  card    Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  kind    String // CardEventKind de @kanban-ai/shared
  payload Json
  ts      DateTime @default(now())

  @@index([cardId, ts])
}

// Fluxo/área do código afetada por uma story (usado na validação final).
model AffectedFlow {
  id     String   @id @default(uuid())
  cardId String
  card   Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  name   String
  files  String[] // paths
  note   String   @default("")

  @@index([cardId])
}

// ─────────────────────────────────────────────────────────────
// Loop engine: diário de iterações
// ─────────────────────────────────────────────────────────────

model Iteration {
  id      String         @id @default(uuid())
  cardId  String // sempre uma task
  card    Card           @relation(fields: [cardId], references: [id], onDelete: Cascade)
  index   Int
  ts      DateTime       @default(now())
  agentId String? // assignee (agent)
  phase   IterationPhase

  detail  String @default("") // registro minucioso (lido pela próxima iteração)
  summary String @default("") // resumo curto

  // handoff
  handoffState    String   @default("") // ExecState | 'blocked' | 'done'
  handoffNextStep String   @default("")
  handoffFiles    String[]
  handoffDodIds   String[]

  // ids de DOD marcados nesta iteração
  dodTouched String[]

  // #6: evidência de verificação do próprio trabalho (ex.: "npm test: 12 passed").
  evidence String @default("")

  // Diff/Replay Viewer: unified diff do worktree capturado ao fim da iteração
  // (git diff HEAD). String vazia quando não houver mudança; truncado no
  // orquestrador para não estourar payload/DB.
  diff String @default("")

  // #8: telemetria de qualidade (todos nullable — sem backfill).
  durationMs   Int? // duração da iteração
  inputTokens  Int? // tokens de entrada (quando o runner reportar)
  outputTokens Int? // tokens de saída (quando o runner reportar)
  outcome      String? // 'ok' | 'derived' | 'failed' | 'awaiting-input'
  // US-OBS2-5 (fatia mínima ex-OBS2-3) — proveniência de uso: provider que
  // produziu a telemetria de tokens (ex.: 'copilot', 'mock'). Nullable/aditivo,
  // sem backfill; base futura para atribuição de custo por provider.
  provider     String?

  @@unique([cardId, index])
  @@index([cardId])
}

/// US-ROB2/US-ROB4 — estado de runtime PERSISTIDO da sessão de agent (por story).
/// Sobrevive a restart (ADR-0029): sessionId estável = storyId da execução.
/// A orquestração continua in-process (SEM Redis); esta tabela é só durabilidade.
model AgentRuntimeState {
  /// sessionId estável (== storyId da execução). Chave natural.
  sessionId String @id

  /// Story cuja execução esta linha representa.
  storyId String @unique

  /// Snapshot serializado do estado de runtime (JSON: fase, task corrente, etc.).
  stateJson String @default("{}")

  /// Totais de tokens acumulados na sessão (JSON: { input, output }).
  tokenTotals String @default("{\"input\":0,\"output\":0}")

  /// Última mensagem de erro observada (null quando saudável).
  lastError String?

  /// Estado de vivacidade persistido (ver LivenessState em @kanban-ai/shared).
  livenessState String @default("starting")

  // ── Lease/claim (US-ROB4) ───────────────────────────────────────────────
  /// Token do claim ativo (quem "segura" a execução). Null = livre.
  claimLock String?

  /// Instante de expiração do lease (TTL + heartbeat). Null = sem claim.
  claimExpiresAt DateTime?

  // ── Loop-breaker de recorrência de bloqueio (EP-BLOCK / US-BLOCK4) ────────
  /// Recorrências CONSECUTIVAS da MESMA causa de bloqueio (cross-run, durável).
  /// Zera ao concluir a story. Ver ADR-0039.
  consecutiveBlockCount Int @default(0)

  /// Assinatura da última causa de bloqueio (blockKind + hash curto do motivo).
  /// null = nunca bloqueou / resetado. Ver ADR-0039.
  lastBlockReason String?

  // ── Continuação bounded de run improdutivo (EP-CTX / US-CTX3) ─────────────
  /// Tentativas CONSECUTIVAS de continuação bounded (plan_only/empty_response)
  /// da story corrente. Zera em qualquer run `advanced`/`completed`. Cross-run,
  /// durável. Ver ADR-0040.
  continuationAttempt Int @default(0)

  /// Motivo/dica da última continuação (ex.: "run anterior só planejou — execute
  /// o próximo passo agora"). Injetado no próximo prompt. null = sem continuação
  /// pendente.
  livenessReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([livenessState])
  @@index([claimExpiresAt])
}

// EP-COLAB / US-COLAB3 — fila de wakeups durável, idempotente e com coalescing.
// Substitui a fila 100% in-process: o PROCESSAMENTO continua in-process (sem
// Redis, invariante 7 / ADR-0019 / ADR-0032), mas o ESTADO da fila é persistido
// para sobreviver a restart e para coalescer (merge) wakeups duplicados por
// story.
model WakeupQueue {
  id      String @id @default(uuid())
  storyId String
  story   Card   @relation("WakeupStory", fields: [storyId], references: [id], onDelete: Cascade)

  // Coalescing: no máximo UM wakeup NÃO-terminal (pending|claimed) por story. Um
  // novo wakeup para uma story que já tem um ativo faz MERGE (incrementa
  // attempts, atualiza reason), não cria linha nova. Garantido pelo índice único
  // PARCIAL adicionado à mão na migration (Prisma v6 não expressa índice parcial
  // no schema — ver ADR-0032).
  status WakeupStatus @default(pending)

  // Por que a story precisa acordar (auditoria + retomada correta pós-restart).
  reason WakeupReason @default(story_in_progress)

  // Contagem de coalescing: quantos wakeups foram mesclados neste registro.
  attempts Int @default(1)

  // Serialização por epic (invariante 7): a fila registra o epic para o
  // processador respeitar "uma story por epic" ao drenar.
  epicId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  claimedAt   DateTime? // quando o processador in-process pegou este item
  processedAt DateTime? // quando concluiu (status=done/failed)

  @@index([status])
  @@index([epicId])
  @@index([storyId])
}

// AgentChatMessage de @kanban-ai/shared. Diferente de Iteration (registro
// minucioso lido pela próxima iteração), aqui vive a CONVERSA: chunks
// consolidados da AI, a pergunta HITL e a RESPOSTA do humano — para reidratar
// o chat ao reabrir a task, sem depender do buffer em memória do front.
model AgentMessage {
  id     String @id @default(uuid())
  cardId String // sempre uma task
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  role  String // 'ai' | 'user' | 'system'
  kind  String? // 'thought' | 'output' (só para role=ai de streaming)
  phase IterationPhase? // fase da iteração, quando conhecida

  text String

  // Vincula pergunta (role=ai) e resposta (role=user) do mesmo par HITL.
  questionId String?

  // Opções de resposta rápida (quick replies) da pergunta HITL, quando houver.
  // Preservadas para reidratar os chips clicáveis após F5/reabertura.
  options Json?

  ts DateTime @default(now())

  @@index([cardId])
}

// ─────────────────────────────────────────────────────────────
// Backlog Chat (ecossistema de criação de Épicos/Histórias)
// ─────────────────────────────────────────────────────────────

// Uma conversa de criação de backlog, ancorada num board (onde os cards
// aprovados vão nascer). Não cria cards por si — só quando o humano aprova.
model BacklogChatSession {
  id      String @id @default(uuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  title  String @default("Novo backlog")
  status String @default("open") // open | applied | archived

  // Versão da proposta corrente (maior BacklogProposalRevision.version); null
  // enquanto a AI ainda está na fase de descoberta (sem proposta).
  currentProposalVersion Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  BacklogChatMessage[]
  revisions BacklogProposalRevision[]
  // Cards (epic/story/task) materializados por esta sessão no apply. Rastreio
  // que habilita o "chat da story" (reuso da sessão) e apply incremental de
  // tasks. Ver ADR-0026.
  cards     Card[]

  @@index([boardId])
}

// Turno persistido do transcript (espelha AgentMessage, mas keyed por sessão).
model BacklogChatMessage {
  id        String             @id @default(uuid())
  sessionId String
  session   BacklogChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role String // 'ai' | 'user' | 'system'
  kind String? // 'thought' | 'output' | 'proposal'

  // Canal (thread) do transcript: 'main' (geral) ou 'story:<storyId>'. Ver ADR-0023.
  channel String @default("main")

  text String

  // Par pergunta↔resposta do refinamento (HITL de descoberta).
  questionId String?
  // Quick replies da pergunta, para reidratar os chips após F5.
  options    Json?
  // Snapshot da proposta quando kind='proposal' (BacklogProposal).
  proposal   Json?

  ts DateTime @default(now())

  @@index([sessionId])
  @@index([sessionId, channel])
}

// Histórico versionado da proposta. Cada patch cirúrgico gera uma nova versão;
// a proposta corrente é a de maior `version`. `/apply` materializa a aprovada.
model BacklogProposalRevision {
  id        String             @id @default(uuid())
  sessionId String
  session   BacklogChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  version  Int
  proposal Json // snapshot completo do BacklogProposal nesta versão

  createdAt DateTime @default(now())

  @@unique([sessionId, version])
  @@index([sessionId])
}

model Label {
  id            String  @id @default(uuid())
  boardId       String
  board         Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name          String
  color         String  @default("#6b778c")
  loopProfileId String? // mapeia para um LoopProfile

  cards CardLabel[]

  @@index([boardId])
}

// Assignee = agent autônomo (não humano).
model Assignee {
  id           String  @id @default(uuid())
  boardId      String
  board        Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name         String
  model        String? // modelo/agent preferido (opus, gpt, ...)
  instructions String  @default("") // "AGENTS.md" do agent: prompt/system instructions

  cards CardAssignee[]

  @@index([boardId])
}

// Perfil de loop (feature|bug|refactor|__default) — comportamento do agent por label.
model LoopProfile {
  id          String             @id @default(uuid())
  boardId     String
  board       Board              @relation(fields: [boardId], references: [id], onDelete: Cascade)
  profileId   String // 'feature' | 'bug' | 'refactor' | '__default' | custom
  name        String
  builtin     Boolean            @default(false)
  description String             @default("")
  phases      IterationPhase[]
  validation  ValidationStrategy
  firstStep   String             @default("")

  @@unique([boardId, profileId])
  @@index([boardId])
}

// ─────────────────────────────────────────────────────────────
// Memória viva (colmeia) — Camada 2: índice Postgres (ADR-0027)
// ─────────────────────────────────────────────────────────────

// Índice da memória: PROJEÇÃO DERIVADA e DESCARTÁVEL dos neurônios .md
// versionados no git (Camada 1 = fonte da verdade). Reconstruível a partir do
// git a qualquer momento — nunca migrar dados de memória para cá. Este model é
// só ARMAZENAMENTO; a lógica de reindex/lock/review vive em outros épicos.
model MemoryIndex {
  // Projeção do neurônio ------------------------------------------------------
  path       String @id // path do neurônio no git (chave natural, ex.: api/cards.md)
  headCommit String // SHA de origem em main projetado neste índice
  title      String @default("")
  tags       String @default("[]") // JSON array serializado (SQLite-friendly / portável)
  summary    String @default("")
  searchText String @default("") // ponteiro de busca (conteúdo/keywords achatados)

  // Coordenação (armazenamento apenas; comportamento vive em EP-78..EP-80) -----
  lockState    String    @default("FREE") // FREE | EDITING | REVIEW (ver MemoryLockState)
  holder       String? // agentId dono do lock ativo (sessão+story), se houver
  leaseId      String? // id do lease advisory ativo (EP-78)
  expiresAt    DateTime? // instante de expiração do lease (TTL + heartbeat, EP-78)
  baseCommit   String? // baseCommit do lock/edição ativa (compare-and-swap)
  activeBranch String? // branch efêmera do agent (mem/ai/<sessao>/<path>)
  reviewQueued Boolean   @default(false) // marcador de fila de REVIEW (conflito semântico)

  // Garbage collection (EP-85) -------------------------------------------------
  stale      Boolean   @default(false) // path some do repo-alvo (candidato a arquivo)
  archivedAt DateTime? // instante em que foi arquivado (git preserva o histórico)
  lastSeenCommit String? // último SHA de main em que o path ainda existia no repo

  updatedAt DateTime @updatedAt

  @@index([lockState])
  @@index([holder])
  @@index([stale])
}

// ─────────────────────────────────────────────────────────────
// Tabelas de junção N:N
// ─────────────────────────────────────────────────────────────

model CardLabel {
  cardId  String
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
}

model CardAssignee {
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  assigneeId String
  assignee   Assignee @relation(fields: [assigneeId], references: [id], onDelete: Cascade)

  @@id([cardId, assigneeId])
  @@index([assigneeId])
}
