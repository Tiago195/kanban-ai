{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "sourceMap": false,
    "isolatedModules": true
  },
  "include": ["src/**/*.spec.ts", "src/**/lib/**/*.ts"]
}
