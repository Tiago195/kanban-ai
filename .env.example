# ─── Banco de dados (Postgres via docker-compose) ───
DATABASE_URL="postgresql://kanban:kanban@localhost:5432/kanban_ai?schema=public"
POSTGRES_USER=kanban
POSTGRES_PASSWORD=kanban
POSTGRES_DB=kanban_ai

# ─── Portas ───
API_PORT=3333
WEB_PORT=5173

# ─── WebSocket ───
# O gateway WS sobe no mesmo servidor da API (path /ws).
WS_PATH=/ws

# ─── Loop engine / agents ───
# Modelo/agent padrão usado pelo AgentRunner (v1: Copilot CLI).
AGENT_DEFAULT_MODEL=opus
# Máximo de sessões de agent rodando simultaneamente (salvaguarda de concorrência).
AGENT_MAX_CONCURRENT_SESSIONS=3
# Intervalo do watchdog em ms (2 min).
AGENT_WATCHDOG_INTERVAL_MS=120000
# Diretório base onde os git worktrees do repo-alvo são criados.
AGENT_WORKSPACES_DIR=./.agent-workspaces

# ─── Frontend ───
# URL base da API consumida pelo apps/web (Vite expõe via import.meta.env).
VITE_API_BASE_URL=http://localhost:3333
VITE_WS_URL=ws://localhost:3333/ws
