{
  "name": "kanban-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Kanban Agile controlado por AIs autônomas — fundação do monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @kanban-ai/api",
    "dev:web": "npm run dev -w @kanban-ai/web",
    "db:migrate": "npm run db:migrate -w @kanban-ai/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @kanban-ai/api",
    "db:seed": "npm run db:seed -w @kanban-ai/api",
    "db:setup": "npm run db:migrate:deploy && npm run db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
